var Control = Java.type("org.parosproxy.paros.control.Control");
var ExtensionHistory = Java.type(
    "org.parosproxy.paros.extension.history.ExtensionHistory"
);
var HttpSender = Java.type("org.parosproxy.paros.network.HttpSender");
var Model = Java.type("org.parosproxy.paros.model.Model");

print("========================================");
print(" ZAP POST CHECK STARTED");
print("========================================");

// ============================================
// CONFIGURATION - Edit these as needed
// ============================================

// Blacklist: Skip URLs that contain ANY of these words (case insensitive)
var BLACKLIST_WORDS = [
    "endsession"
];

// Authorization Header Configuration
// Set this to null or empty string to use the original request's headers
// Otherwise, it will replace the Authorization header with your custom value
var AUTHORIZATION_HEADER = null;  // Change this to your token
// Example: var AUTHORIZATION_HEADER = "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...";
// Example: var AUTHORIZATION_HEADER = "Basic YWxhZGRpbjpvcGVuc2VzYW1l";

// Optional: Specify a custom header name (default is "Authorization")
var AUTH_HEADER_NAME = "Authorization";

// Optional: Whitelist - Only process URLs that contain ANY of these words (empty = process all)
// If you want to use whitelist instead of blacklist, uncomment below and comment out BLACKLIST_WORDS
// var WHITELIST_WORDS = [
//     "api",
//     "admin",
//     "report"
// ];

// ============================================

try {

    var control = Control.getSingleton();

    var history = control.getExtensionLoader()
        .getExtension(ExtensionHistory.class);

    if (history == null) {
        print("[ERROR] ExtensionHistory not available.");
    } else {

        print("[OK] ExtensionHistory found.");

        var table = history.getHistoryReferencesTable();
        var model = table.getModel();

        print("[OK] History table obtained.");
        print("[INFO] History rows: " + model.getRowCount());

        // Print authorization header configuration
        if (AUTHORIZATION_HEADER && AUTHORIZATION_HEADER.length > 0) {
            print("[INFO] Using custom Authorization header: " + AUTHORIZATION_HEADER.substring(0, 20) + "...");
        } else {
            print("[INFO] Using original request headers (no custom auth)");
        }

        var found = 0;
        var uniqueUrls = {};
        var blacklistedCount = 0;

        // First pass: collect unique POST URLs
        for (var i = 0; i < model.getRowCount(); i++) {

            var ref = model.getHistoryReference(i);

            if (ref == null) {
                continue;
            }

            var msg = ref.getHttpMessage();

            if (msg == null) {
                continue;
            }

            // Only requests currently in ZAP scope
            if (!msg.isInScope()) {
                continue;
            }

            // POST only
            var method = msg.getRequestHeader().getMethod();

            if (!"POST".equalsIgnoreCase(method)) {
                continue;
            }

            var url = msg.getRequestHeader()
                .getURI()
                .toString();

            // Check if URL contains any blacklisted word
            var isBlacklisted = false;
            if (BLACKLIST_WORDS && BLACKLIST_WORDS.length > 0) {
                var urlLower = url.toLowerCase();
                for (var b = 0; b < BLACKLIST_WORDS.length; b++) {
                    if (urlLower.indexOf(BLACKLIST_WORDS[b].toLowerCase()) !== -1) {
                        isBlacklisted = true;
                        blacklistedCount++;
                        break;
                    }
                }
            }

            // Uncomment this block if using whitelist instead
            /*
            var isWhitelisted = false;
            if (WHITELIST_WORDS && WHITELIST_WORDS.length > 0) {
                var urlLower = url.toLowerCase();
                for (var w = 0; w < WHITELIST_WORDS.length; w++) {
                    if (urlLower.indexOf(WHITELIST_WORDS[w].toLowerCase()) !== -1) {
                        isWhitelisted = true;
                        break;
                    }
                }
            }
            // Skip if not whitelisted
            if (!isWhitelisted) {
                continue;
            }
            */

            // Store unique URLs with their message (skip blacklisted ones)
            if (!isBlacklisted && !uniqueUrls[url]) {
                uniqueUrls[url] = msg;
            }
        }

        print("[INFO] Blacklisted endpoints skipped: " + blacklistedCount);
        print("[INFO] Unique POST endpoints to test: " + Object.keys(uniqueUrls).length);

        // Second pass: process each unique URL
        var processed = 0;
        for (var url in uniqueUrls) {
            processed++;
            var msg = uniqueUrls[url];

            var status = msg.getResponseHeader()
                .getStatusCode();

            print("");
            print("----------------------------------------");
            print("POST #" + processed + " (Unique)");
            print("URL    : " + url);
            print("STATUS : " + status);

            if (status == 200) {
                print("RESULT : OK");
            }
            else if (status == 403) {
                print("RESULT : NOT OK");
            }
            else {
                print("RESULT : REVIEW");
            }

            // Resend the request and get response body
            try {
                print("");
                print("[RESENDING REQUEST]");
                
                // Clone the original message to resend
                var clonedMsg = msg.cloneAll();
                
                // Apply custom authorization header if configured
                if (AUTHORIZATION_HEADER && AUTHORIZATION_HEADER.length > 0) {
                    // Set the Authorization header
                    clonedMsg.getRequestHeader().setHeader(AUTH_HEADER_NAME, AUTHORIZATION_HEADER);
                    print("[AUTH] Using custom " + AUTH_HEADER_NAME + ": " + AUTHORIZATION_HEADER.substring(0, 20) + "...");
                } else {
                    // Keep original headers (do nothing)
                    print("[AUTH] Using original headers from captured request");
                }
                
                // Get connection parameters from Model
                var connectionParam = Model.getSingleton().getOptionsParam().getConnectionParam();
                
                // Create HttpSender with the connection parameters
                var httpSender = new HttpSender(
                    connectionParam,
                    true,
                    HttpSender.MANUAL_REQUEST_INITIATOR
                );
                
                // Send the request
                httpSender.sendAndReceive(clonedMsg, true);
                
                // Get the new response body
                var responseBody = clonedMsg.getResponseBody().toString();
                var newStatusCode = clonedMsg.getResponseHeader().getStatusCode();
                
                print("NEW STATUS : " + newStatusCode);
                print("RESPONSE BODY:");
                print("----------------------------------------");
                // Truncate if too long
                if (responseBody.length > 2000) {
                    print(responseBody.substring(0, 2000) + "... (truncated)");
                } else {
                    print(responseBody);
                }
                print("----------------------------------------");
                
            } catch (sendError) {
                print("[ERROR] Failed to resend request: " + sendError);
                print("Stack: " + sendError.stack);
            }
        }

        print("");
        print("========================================");
        print(" UNIQUE POST ENDPOINTS TESTED: " + processed);
        print(" BLACKLISTED ENDPOINTS SKIPPED: " + blacklistedCount);
        print("========================================");
        
        // Print all blacklisted URLs for reference
        if (blacklistedCount > 0) {
            print("");
            print("[INFO] Blacklisted URLs (skipped):");
            var blacklistedUrls = [];
            for (var i = 0; i < model.getRowCount(); i++) {
                var ref = model.getHistoryReference(i);
                if (ref == null) continue;
                var msg = ref.getHttpMessage();
                if (msg == null) continue;
                if (!msg.isInScope()) continue;
                var method = msg.getRequestHeader().getMethod();
                if (!"POST".equalsIgnoreCase(method)) continue;
                var url = msg.getRequestHeader().getURI().toString();
                var urlLower = url.toLowerCase();
                for (var b = 0; b < BLACKLIST_WORDS.length; b++) {
                    if (urlLower.indexOf(BLACKLIST_WORDS[b].toLowerCase()) !== -1) {
                        if (blacklistedUrls.indexOf(url) === -1) {
                            blacklistedUrls.push(url);
                        }
                        break;
                    }
                }
            }
            for (var i = 0; i < blacklistedUrls.length; i++) {
                print("  - " + blacklistedUrls[i]);
            }
        }
        print("========================================");
    }

} catch (e) {

    print("");
    print("========================================");
    print(" ERROR");
    print("========================================");
    print(e);
    print(e.stack);
}
